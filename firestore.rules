rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Surplus listings: public read for hyper-local food radar, create & update for volunteers/providers
    match /surplus_listings/{listingId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;

      // Real-time dispatch and handover logistics messages
      match /messages/{messageId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if request.auth != null;
      }
    }

    // User profile records and volunteer gamification
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Global aggregated rescue metrics
    match /system_stats/{statId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
